DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1,codehubph.tech
# Required for forms on the public HTTPS site.
CSRF_TRUSTED_ORIGINS=https://codehubph.tech

DB_NAME=codehubph_db
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

PAYPAL_ME_URL=https://paypal.me/your-paypal-handle

SITE_NAME=CodehubPh
# Legal identity and privacy contact; defaults use the configured site name/support email.
LEGAL_OWNER_NAME=
LEGAL_CONTACT_ADDRESS=
PRIVACY_CONTACT_EMAIL=
# Absolute base URL used in email links. Local development can use http://127.0.0.1:8000.
SITE_URL=https://codehubph.tech
CURRENCY=PHP
CURRENCY_SYMBOL=₱

# Optional dedicated Fernet key for admin AI credentials. Keep stable with DB backups.
# If empty, a purpose-specific key is derived from SECRET_KEY.
AI_CREDENTIAL_ENCRYPTION_KEY=

# PayPal: "manual" (PayPal.me + admin verification) or "automated" (Orders API v2)
PAYPAL_MODE=manual
# sandbox or live
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_WEBHOOK_ID=

# GCash: manual (number + QR + proof upload) or paymongo (stub)
GCASH_PROVIDER=manual

# Card gateway adapter: paypal (Advanced Card Fields), paymongo or stripe (stubs)
CARD_PROVIDER=paypal

# Uploads
MAX_PRODUCT_FILE_MB=500
MAX_IMAGE_MB=5
# Large staff uploads are sent in chunks of this size (keep below Nginx client_max_body_size;
# Cloudflare rejects requests over 100 MB). Unfinished uploads expire after UPLOAD_SESSION_HOURS.
UPLOAD_CHUNK_MB=8
UPLOAD_SESSION_HOURS=24
DOWNLOAD_LIMIT=10
DOWNLOAD_EXPIRY_DAYS=30

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=15
DEFAULT_FROM_EMAIL=CodehubPh <no-reply@example.com>
PASSWORD_RESET_TIMEOUT=3600
EMAIL_VERIFICATION_TIMEOUT=86400
AUTH_EMAIL_DELIVERY_MODE=background
# Gmail: smtp.gmail.com, port 587, TLS=True, SSL=False; use a Google app password.
# Yahoo: smtp.mail.yahoo.com, port 587, TLS=True, SSL=False.
# EMAIL_HOST_USER is the full Yahoo address; EMAIL_HOST_PASSWORD is its app password.
# Run the durable delivery worker: python manage.py send_auth_emails --loop

# Production security (applied only when DEBUG=False)
SECURE_SSL_REDIRECT=True
# True when Gunicorn is only reachable through Nginx (e.g. with Cloudflare Tunnel); uses X-Real-IP.
BEHIND_PROXY=False
SECURE_HSTS_SECONDS=31536000
